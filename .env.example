# ============================================================
# ASTRO — Variables de entorno
# Copiar a .env.local y completar con los valores del proyecto
# Supabase (Dashboard → Settings → API / Database).
# ============================================================

# URL del proyecto Supabase (https://<ref>.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Clave pública (anon) — segura para el navegador, RLS aplica
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave service_role — SOLO servidor, salta RLS. Nunca exponer.
SUPABASE_SERVICE_ROLE_KEY=

# Cadena de conexión directa a Postgres (para supabase db push / migraciones)
# postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres
SUPABASE_DB_URL=

# URL pública de la app (links firmados de catálogo/carrito)
NEXT_PUBLIC_APP_URL=http://localhost:3000
